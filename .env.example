# Default weather location (can also be set from Settings > General in the UI).
# Weather now uses Open-Meteo, so no API key is required.
OPENWEATHER_LATITUDE=LATITUDE
OPENWEATHER_LONGITUDE=LONGITUDE

# Proxmox cluster (optional). List one or more nodes; they're tried in order,
# so the dashboard keeps working when a node is down.
# PROXMOX_URL=https://192.168.1.10:8006,https://192.168.1.11:8006
# PROXMOX_TOKEN_ID=homedash@pve!dashboard
# PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Set to true once your nodes have trusted certificates (self-signed is accepted by default).
# PROXMOX_VERIFY_TLS=false

# Optional: where the Sounds widget keeps its audio files (defaults to ./data/sounds).
# SOUNDS_DIR=/app/data/sounds

# Optional: comma-separated mounts for the Storage widget, optionally labeled.
# DISK_PATHS=Root=/,NAS=/mnt/nas
